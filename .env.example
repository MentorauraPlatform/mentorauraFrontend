# ─────────────────────────────────────────────────────────────────────────────
# Mentoraura Frontend — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Accessible client-side in browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Accessible server-side (SSR / Server Components / BFF proxy)
INTERNAL_API_URL=http://localhost:4000/api/v1

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Mentoraura
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Analytics (Phase 2) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Sentry ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
